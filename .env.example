# HostFi Environment Variables
# Copy this to .env.local and fill in your values

# =============================================================================
# REQUIRED — App won't function without these
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AI — Required for bill parsing and Ask AI
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Stripe — Required for billing/subscriptions
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_...
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_...

# =============================================================================
# Google — Required for Sheets/Drive/Picker/Maps integrations
# =============================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=your-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key

# =============================================================================
# Email — Postmark for transactional emails and inbound bill parsing
# =============================================================================
POSTMARK_SERVER_TOKEN=your-server-token
POSTMARK_FROM_EMAIL=alerts@hostfi.ai
POSTMARK_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Slack Integration
# =============================================================================
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret

# =============================================================================
# PMS Integrations (optional — enable as needed)
# =============================================================================

# Guesty
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# OwnerRez
OWNERREZ_OAUTH_CLIENT_ID=
OWNERREZ_OAUTH_CLIENT_SECRET=
OWNERREZ_WEBHOOK_USER=
OWNERREZ_WEBHOOK_PASSWORD=

# =============================================================================
# Plaid — Bank account sync (optional, requires production approval)
# =============================================================================
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# =============================================================================
# Security & Cron
# =============================================================================
CREDENTIALS_ENCRYPTION_KEY=
CRON_SECRET=your-cron-secret
WEBHOOK_SECRET=your-webhook-secret
