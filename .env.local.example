# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI (Ask AI, receipt scanning, bill parsing)
ANTHROPIC_API_KEY=sk-ant-xxx

# Webhook security (required in production)
WEBHOOK_SECRET=your-webhook-secret

# Stripe (billing & subscriptions)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_xxx
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_xxx

# Google OAuth (Sheets + Drive integration)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Slack (two-way sync)
SLACK_CLIENT_ID=xxx
SLACK_CLIENT_SECRET=xxx
SLACK_SIGNING_SECRET=xxx
SLACK_BOT_TOKEN=xoxb-xxx

# Plaid (bank transaction sync)
PLAID_CLIENT_ID=xxx
PLAID_SECRET=xxx
PLAID_ENV=sandbox

# Supabase Service Role (for webhook handlers)
SUPABASE_SERVICE_ROLE_KEY=xxx

# App URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=https://hostfi.ai
